{
  "name": "personahub-desktop",
  "version": "0.2.1",
  "private": true,
  "description": "PersonaHub Desktop — Local Agent Runner",
  "author": "Magic Worlds",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "electron:dev": "vite build && electron .",
    "electron:build": "tsc -b && vite build && electron-builder --config electron-builder.config.js",
    "electron:build:mac": "tsc -b && vite build && electron-builder --mac --config electron-builder.config.js",
    "electron:build:win": "tsc -b && vite build && electron-builder --win --config electron-builder.config.js",
    "electron:build:linux": "tsc -b && vite build && electron-builder --linux --config electron-builder.config.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:a11y": "axe --exit http://localhost:5173"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.84.0",
    "better-sqlite3": "^11.0.0",
    "electron-updater": "^6.3.0",
    "mammoth": "^1.11.0",
    "openclaw": "^2026.4.7",
    "pdf-parse": "1.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hot-toast": "^2.6.0",
    "uuid": "^11.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.11.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.11",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "electron": "^35.0.0",
    "electron-builder": "^25.0.0",
    "jsdom": "^29.0.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.0",
    "vitest": "^4.0.18"
  }
}
